(ui task-tracker
  (theme
    (palette bg "#f8f9fa")
    (palette bg-surface "#ffffff")
    (palette bg-sidebar "#1e293b")
    (palette accent "#3b82f6")
    (palette accent-hover "#2563eb")
    (palette danger "#ef4444")
    (palette text-primary "#1e293b")
    (palette text-secondary "#64748b")
    (palette text-inverse "#ffffff")
    (palette border "#e2e8f0")
    (palette success "#22c55e")
    (spacing xs 4)
    (spacing sm 8)
    (spacing md 16)
    (spacing lg 24)
    (spacing xl 32)
    (font-size sm 12)
    (font-size base 14)
    (font-size lg 18)
    (font-size xl 24)
    (radius sm 4)
    (radius md 6)
    (radius lg 8))
  (component button
    (interactive click)
    (padding (spacing sm) (spacing md))
    (corner (radius md))
    (bg (palette accent))
    (color (palette text-inverse))
    (variant danger (bg (palette danger)))
    (variant outline (bg (palette bg-surface)) (color (palette accent)) (border 1 (palette accent))))
  (component card
    (padding (spacing md))
    (corner (radius lg))
    (bg (palette bg-surface))
    (border 1 (palette border)))
  (component input-field
    (interactive click)
    (padding (spacing sm) (spacing md))
    (corner (radius md))
    (border 1 (palette border))
    (bg (palette bg-surface))
    (width full))
  (component nav-item
    (interactive click)
    (padding (spacing sm) (spacing md))
    (corner (radius sm))
    (color (palette text-inverse))
    (variant active (bg (palette accent))))
  (layout app-shell
    (ui root
      (layout horizontal)
      (width full)
      (height full)
      (children
        (ui sidebar
          (layout vertical)
          (width (px 240))
          (height full)
          (bg (palette bg-sidebar))
          (padding (spacing md))
          (gap (spacing sm))
          (children ..nav))
        (ui main
          (layout vertical)
          (width grow)
          (height full)
          (bg (palette bg))
          (padding (spacing lg))
          (gap (spacing md))
          (scroll vertical)
          (children ..content)))))
  (layout sidebar-layout
    (ui root
      (layout vertical)
      (width full)
      (height full)
      (bg (palette bg-sidebar))
      (padding (spacing md))
      (gap (spacing sm))
      (children
        (ui brand
          (padding (spacing md))
          (children (text "TaskTracker")))
        (ui nav (children ..nav))
        (ui spacer (height grow))
        (ui user-section
          (padding (spacing md))
          (color (palette text-inverse))
          (children ..user-info)))))
  (page projects
    (use-layout app-shell)
    (fill nav (nav-item (text "Projects"))
              (nav-item (text "Tasks"))
              (nav-item (text "Settings")))
    (fill content (text "Projects")
                   (card (text "Project list goes here"))))
  (page tasks
    (use-layout app-shell)
    (fill nav (nav-item (text "Projects"))
              (nav-item (text "Tasks"))
              (nav-item (text "Settings")))
    (fill content (text "Tasks")
                   (card (text "Task list goes here"))))
  (page task-detail
    (use-layout app-shell)
    (fill nav (nav-item (text "Projects"))
              (nav-item (text "Tasks"))
              (nav-item (text "Settings")))
    (fill content (text "Task Detail")
                   (card (text "Task detail view"))))
  (routes
    (route "/" projects)
    (route "/tasks" tasks)
    (route "/tasks/:id" task-detail)))
