(project borge-lib-ui
 (section ui
  (doc "UI DSL types and parsing. lib/ui/")
  (status implemented)
  (subsection ui-ast
   (doc "Typed AST for borge UI specs")
   (status implemented)
   (details
    (doc (|
         ui_ast.ml defines typed representations: ui_element, component,
         layout_def, page, route, theme, variant, and all value types
         (sizing, color_value, spacing_value, etc.). The UI types are
         consumers of the generic sexp AST — they do NOT modify the parser.
       |))
   )
  )
  (subsection ui-parse
   (doc "Sexp to typed UI AST extraction")
   (status implemented)
   (details
    (doc (|
         ui_parse.ml walks the generic Ast.sexp tree and extracts
         typed UI nodes. Functions like parse_ui_element, parse_theme,
         parse_component, parse_layout_def, parse_page, parse_routes,
         parse_ui_app. The parser stays generic; this module
         interprets the semantic structure of UI-specific forms.
       |))
   )
  )
  (subsection ui-validate
   (doc "Semantic validation for UI specs")
   (status implemented)
   (details
    (doc (|
         Checks: variant names are unique per element, theme variable
         references (palette, spacing, font-size, radius) are defined,
         component and layout names are unique, page layout references
         point to defined layouts. Returns structured issues with
         severity (error/warning).
       |))
   )
  )
  (subsection ui-json
   (doc "JSON serialization for UI AST")
   (status implemented)
   (details
    (doc (|
         ui_json.ml serializes the typed UI AST to yojson for --json
         output. Covers all types: sizing, color, spacing, elements,
         components, pages, routes, themes.
       |))
   )
  )
  (subsection ui-dream
   (doc "Dream HTML code generation from UI AST")
   (status implemented)
   (implements lib
    ui
    ui_dream.ml
   )
   (details
    (doc (|ui_dream.ml generates Dream HTML output from the typed UI AST.|))
   )
  )
  (subsection ui-clay
   (doc "Clay CSS code generation from UI AST")
   (status implemented)
   (details
    (doc (|ui_clay.ml generates CSS output from the typed UI AST.|))
   )
  )
 )
)
