(project borge-lib
 (doc "Domain operations: checking, reporting, formatting, spec extraction")
 (status planned)
 (section spec
  (doc "Borge-specific types and operations on top of the sexp AST")
  (status implemented)
  (details
   (doc (|
        Types: status (planned, in-progress, partial, implemented,
        drifted, blank). Functions: status_of_string, string_of_status,
        project_name, count_sections, statuses, status_counts.
      |))
  )
 )
 (section file-utils
  (doc "File discovery and reading shared by all commands")
  (status planned)
  (details
   (doc (|
        find_borg_files: recursively discover .borg files, skipping
        _build and .git. read_file: read a file into a string.
        Currently duplicated in bin/borge_check.ml and
        bin/borge_report.ml and bin/borge_fmt.ml. Must be in lib.
      |))
  )
 )
 (section check
  (doc "Recursive health check across all .borg files")
  (status implemented)
  (details
   (doc (|
        Walks a directory, finds .borg files, parses each, reports
        project name and validity. Returns a typed result per file
        with pass/fail status. Currently the check logic is in bin/
        and reimplements project_name extraction - must move to lib.
      |))
  )
 )
 (section report
  (doc "Status summary across all .borg files")
  (status implemented)
  (details
   (doc (|
        Aggregates status counts per file and globally. Returns typed
        data: per-file (name, impl, in-progress, planned) and totals.
        Currently the report formatting is interleaved with data
        extraction in bin/ - must separate data from presentation.
      |))
  )
 )
 (section fmt
  (doc "Auto-format a .borg file to canonical indentation")
  (status implemented)
  (details
   (doc (|
        Parses and re-prints. The formatting logic is in sexp/print.ml
        (correct - it belongs there). The CLI wrapper in bin/ should
        just call parse then print. Must add --check and --diff modes.
      |))
  )
 )
 (section drift
  (doc "Detect spec drift, code drift, and structural drift")
  (status planned)
  (details
   (doc (|
        Three drift layers:
        1. Spec drift: .borg describes something not in code
        2. Code drift: code has something not in .borg
        3. Structural drift: code organization does not match inline
           architecture (e.g. domain logic in bin/ when lib owns it)

        Structural drift is the most insidious because it compounds:
        when logic is in the wrong layer, it gets duplicated, the
        duplication diverges, and the codebase rots.
      |))
  )
 )
)

