(project borge-lib
 (doc "Domain operations: checking, reporting, formatting, spec extraction.
       Organized into concern-based subdirectories under lib/ with
       include_subdirs unqualified — same flat namespace, better layout.")
 (status implemented)
 (exports project_name find_roots find_orphans
          run_lint run_check run_report run_drift run_fmt
          generate_code extract_surface parse_dune
          count_sections status_counts tree_status_counts
          new_bug list_bugs load_bug save_bug close_bug
          json_drift json_report json_spec
          bug_ast bug_parse bug_write bug_registry
          borg_comment module_spec semantic_review)
 (section core
  (doc "Spec model: what borge files ARE. lib/core/")
  (status implemented)
  (subsection spec
   (doc "Borge-specific types and operations on top of the sexp AST")
   (status implemented)
   (details
    (doc (|
         Types: status (planned, in-progress, partial, implemented,
         drifted, blank). Functions: status_of_string, string_of_status,
         project_name, count_sections, statuses, status_counts,
         inline_targets, has_no_inline.
       |))
   )
  )
  (subsection file-utils
   (doc "File discovery and reading shared by all commands")
   (status implemented)
   (details
    (doc (|
         find_borg_files: recursively discover .borg files, skipping
         _build and .git. read_file: read a file into a string.
       |))
   )
  )
  (subsection project
   (doc "Inline tree building and orphan detection")
   (status implemented)
   (details
    (doc (|
         build_tree: recursively follow inline directives from a root
         .borg file, producing a project_node tree. Each node carries
         its path, project_name, children, and orphan status.

         find_roots: find .borg files not inlined by any other file.
         find_orphans: find files not in any tree, no (no-inline), and
         don't inline any children themselves.

         tree_status_counts: count statuses across the tree without
         double-counting inlined sub-specs.

         format_tree: indented text representation of the tree.
       |))
   )
  )
 )
 (section check
  (doc "Validation and analysis. lib/check/")
  (status implemented)
  (subsection check-command
   (doc "Recursive health check across all .borg files")
   (status implemented)
   (details
    (doc (|
         Walks a directory, finds .borg files, parses each, reports
         project name and validity. Returns a typed result per file
         with pass/fail status and warnings (orphan detection).
       |))
   )
  )
  (subsection report
   (doc "Status summary across all .borg files")
   (status implemented)
   (details
    (doc (|
         Aggregates status counts per file and globally. Returns typed
         data: per-file (name, impl, in-progress, planned) and totals.
         Uses inline tree to avoid double-counting sub-specs.
         Reports orphaned files.
       |))
   )
  )
  (subsection lint
   (doc "Semantic validation of .borg files")
   (status implemented)
   (details
    (doc (|
         Checks: invalid status values, duplicate project names,
         unknown comment types, missing comment values, deleted
         human comments (against git HEAD), pending ask/response
         slots, orphaned files.
       |))
   )
  )
  (subsection drift
   (doc "Detect spec drift, code drift, and structural drift")
   (status implemented)
   (details
    (doc (|
         Three drift layers:
         1. Spec drift: .borg describes something not in code
         2. Code drift: dune-aware — modules from dune files not in .borg
         3. Structural drift: code organization does not match inline
            architecture

         Generates .borg.meta files with findings, module surfaces,
         and dune snapshots. Supports --agent flag for LLM-driven
         semantic analysis.
       |))
   )
  )
  (subsection dune-parse
   (doc "Parse dune files for structural drift detection")
   (status implemented)
   (details
    (doc (|
         Parses dune (sexp) files to extract library, executable,
         and test stanzas. Returns typed records with name, modules,
         public_name, and libraries. Used by drift for cross-referencing
         dune structure against .borg spec sections.
       |))
   )
  )
  (subsection surface
   (doc "Extract public module interface from .ml/.mli files")
   (status implemented)
   (details
    (doc (|
         For modules with .mli: .mli is the authoritative surface.
         For modules without .mli: infer from top-level let bindings,
         type definitions, exceptions, and module declarations.
         Returns module_name, file path, and export list.
       |))
   )
  )
  (subsection meta
   (doc "Types and writer for .borg.meta companion files")
   (status implemented)
   (details
    (doc (|
         .borg.meta files hold machine-generated observations:
         analyzed-at timestamp, content hashes, module surfaces,
         dune snapshots, and findings. The writer is idempotent
         and deterministic. Findings are sorted for clean git diffs.
         Agent findings merge (replace) on re-run; static findings
         are preserved.
       |))
   )
  )
 )
 (section format
  (doc "Formatting and display. lib/format/")
  (status implemented)
  (subsection fmt
   (doc "Auto-format a .borg file to canonical indentation")
   (status implemented)
   (details
    (doc (|
         Parses and re-prints with canonical indentation. Supports
         --check (exit 1 if formatting would change) and --diff
         (show line-by-line diff).
       |))
   )
  )
  (subsection nodes
   (doc "Dump the parsed AST with types and positions for debugging")
   (status implemented)
   (details
    (doc (|
         Walks the AST and prints each node with its type, keyword (if
         list), source position, and child count. Useful for debugging
         mismatches between source and AST.
       |))
   )
  )
 )
 (section generate
  (doc "LLM-driven generation. lib/generate/")
  (status implemented)
  (subsection generate-command
   (doc "Generate spec sections and code from specs via LLM")
   (status implemented)
   (details
    (doc (|
         Two subcommands: generate spec (todo -> .borg section) and
         generate code (spec -> implementation). Both use pi -p via
         Agent.run_pi_print. Generate spec takes free-form text and
         produces a structured (status planned) section. Generate code
         reads a planned section's spec text and module surfaces, then
         invokes pi to write the implementation.
       |))
   )
  )
  (subsection agent
   (doc "LLM-driven semantic drift analysis")
   (status implemented)
   (details
    (doc (|
         Assembles context (spec + code + existing findings) into a
         prompt, invokes an LLM via BORGE_AGENT_CMD env var, parses
         the sexp response into typed findings. Parse failures are
         discarded — never corrupt .borg.meta. Agent findings merge
         with static findings (static preserved, agent replaced).
       |))
   )
  )
  (subsection review-quality
   (doc "Per-file LLM code quality assessment against spec")
   (status implemented)
   (details
    (doc (|
         review_quality.ml: for each implemented section, find the
         corresponding source file, build a prompt comparing spec vs
         code, call pi -p, and return structured findings. Exposed
         via borge review --agent.
       |))
   )
  )
 )
 (section metrics
  (doc "Code statistics. lib/metrics/")
  (status implemented)
  (subsection stats
   (doc "Code intelligence metrics: lines, functions, exports per file")
   (status implemented)
   (details
    (doc (|
         Scans all .ml files and reports: line count, function count,
         average function length, export count, doc coverage, mli status.
         Aggregates into project totals. Filters _build, .git, test dirs.
         Doc coverage is a placeholder (0%) — proper nested-comment parsing
         needs a real lexer.
       |))
   )
  )
 )
 (section output
  (doc "Structured output formats. lib/output/")
  (status implemented)
  (subsection json
   (doc "JSON serialization for --json flag across borge commands")
   (status implemented)
   (details
    (doc (|
         Yojson-based serializers for Report, Check, Lint, Drift, Stats,
         and Balance result types. Each command's --json flag calls the
         corresponding Json_out.to_json function and prints the result.
       |))
   )
  )
  (subsection json-out
   (doc "Individual JSON output serializers")
   (status implemented)
   (details (doc (|Json_out contains to_json functions for each command result.|)))
  )
 )
 (section ui
  (doc "UI DSL types and parsing. lib/ui/")
  (status implemented)
  (subsection ui-ast
   (doc "Typed AST for borge UI specs")
   (status implemented)
   (details
    (doc (|
         ui_ast.ml defines typed representations: ui_element, component,
         layout_def, page, route, theme, variant, and all value types
         (sizing, color_value, spacing_value, etc.). The UI types are
         consumers of the generic sexp AST — they do NOT modify the parser.
       |))
   )
  )
  (subsection ui-parse
   (doc "Sexp to typed UI AST extraction")
   (status implemented)
   (details
    (doc (|
         ui_parse.ml walks the generic Ast.sexp tree and extracts
         typed UI nodes. Functions like parse_ui_element, parse_theme,
         parse_component, parse_layout_def, parse_page, parse_routes,
         parse_ui_app. The parser stays generic; this module
         interprets the semantic structure of UI-specific forms.
       |))
   )
  )
  (subsection ui-validate
   (doc "Semantic validation for UI specs")
   (status implemented)
   (details
    (doc (|
         Checks: variant names are unique per element, theme variable
         references (palette, spacing, font-size, radius) are defined,
         component and layout names are unique, page layout references
         point to defined layouts. Returns structured issues with
         severity (error/warning).
       |))
   )
  )
  (subsection ui-json
   (doc "JSON serialization for UI AST")
   (status implemented)
   (details
    (doc (|
         ui_json.ml serializes the typed UI AST to yojson for --json
         output. Covers all types: sizing, color, spacing, elements,
         components, pages, routes, themes.
       |))
   )
  )
 )
 (section lock
  (doc "Transactional isolation for agent sessions. lib/lock/")
  (status implemented)
  (subsection lock-core
   (doc "Lock directory creation, state management, commit/abort")
   (status implemented)
   (details
    (doc (|
         Lock.create: snapshot all .borg files to .borge.lock/original/
         Lock.set_state/get_state: running | completed | failed
         Lock.check_integrity: detect deleted human-authored comments
         Lock.restore: abort — restore .borg files from snapshot
         Lock.teardown: commit or abort with cleanup
         Lock.remove: delete lock directory after commit/abort
       |))
   )
  )
  (subsection lock-prompt
   (doc "Prompt builder for agent sessions")
   (status implemented)
   (details
    (doc (|
         Role definitions: Implementer, Spec_writer, Observer, Fixer.
         Assembles prompts from spec files, module surfaces, and
         role declarations. Does not depend on Borge_lib internals
         to avoid cyclic deps.
       |))
   )
  )
  (subsection lock-pi-launch
   (doc "Launch pi interactively with structured prompt")
   (status implemented)
   (details
    (doc (|
         Simple wrapper: pi @prompt_path. Direct invocation —
         pi is interactive so backgrounding loses status.
       |))
   )
  )
 )
 (section db
  (doc "DB DSL types and parsing. lib/db/")
  (status implemented)
  (subsection db-ast
   (doc "Typed AST for borge DB specs")
   (status implemented)
   (details
    (doc (|
         db_ast.ml defines typed representations: table_def, column,
         operations_def, relation_def, group_def, capability, and all
         value types (column_constraint, crud_spec, join_type, etc.).
         The DB types are consumers of the generic sexp AST.
       |))
   )
  )
  (subsection db-parse
   (doc "Sexp to typed DB AST extraction")
   (status implemented)
   (details
    (doc (|
         db_parse.ml walks the generic Ast.sexp tree and extracts
         typed DB nodes. Functions like parse_table, parse_column,
         parse_operations, parse_relation, parse_group, parse_db_app.
       |))
   )
  )
  (subsection db-validate
   (doc "Semantic validation for DB specs")
   (status implemented)
   (details
    (doc (|
         Checks: table and column names are unique, (references
         table.column) refers to an existing table, (ownership column)
         refers to an existing column on the same table, operations
         reference existing tables, relation from-tables and join tables
         exist, group capability tables exist. Returns structured issues
         with severity (error/warning).
       |))
   )
  )
  (subsection db-json
   (doc "JSON serialization for DB AST")
   (status implemented)
   (details
    (doc (|
         db_json.ml serializes the typed DB AST to yojson for --json
         output. Covers all types: tables, columns, operations,
         relations, groups, capabilities.
       |))
   )
  )
 )
 (section bug
  (doc "Issue tracking for repo-stored bugs")
  (status implemented)
  (subsection bug-ast
   (doc "Bug AST types and operations")
   (status implemented)
   (details (doc (|Bug_ast defines bug type, status workflow, and helper functions.|)))
  )
  (subsection bug-parse
   (doc "Parse .borge-bug files")
   (status implemented)
   (details (doc (|Bug_parse reads .borge-bug files into typed bug records.|)))
  )
  (subsection bug-registry
   (doc "Manage .borge-bug directory")
   (status implemented)
   (details (doc (|Bug_registry handles file paths, listing, loading, saving bugs.|)))
  )
  (subsection bug-write
   (doc "Write bugs to .borge-bug files")
   (status implemented)
   (details (doc (|Bug_write renders bug records to .borge-bug file format.|)))
  )
 )
 (section distributed
  (doc "Distributed specs: module-level .borg files")
  (status implemented)
  (subsection borg-comment
   (doc "Parse borg-comments from OCaml source")
   (status implemented)
   (details (doc (|Extract (* (fn name ...) *) comments from .ml files.|)))
  )
  (subsection module-spec
   (doc "Discover and parse module .borg files")
   (status implemented)
   (details (doc (|Find all .borg files, extract exports, check integrity.|)))
  )
 )
 (section review
  (doc "Semantic code review with LLM")
  (status planned)
  (subsection semantic-review
   (doc "Verify function docs match implementation")
   (status planned)
   (details
    (doc (|
       semantic_review.ml implements per-function LLM verification.

       Extraction: Uses compiler-libs/ocaml-common to parse .ml/.mli
       files into Parsetree. Extracts:
       - Value bindings (Pstr_value)
       - Docstrings (attribute "ocaml.doc")
       - Type signatures (from .mli when available)

       Batching: Files with >20 functions are batched into groups
       of 15-20, alphabetically sorted for determinism.

       LLM Prompt: See meta.borg (section semantic-review-integration)
       for the exact prompt template. Returns structured sexp that
       parses into semantic_finding record.

       Error handling: Parse failures are logged to stderr with raw
       response preserved for debugging. Previous .borg.meta content
       is preserved — never corrupt metadata.

       Data types:
       - doc_present: bool — is there a docstring/comment?
       - doc_accuracy: high | medium | low — does doc match code?
       - signature_match: accurate | mismatch | unknown
       - behavior_coverage: complete | partial | missing
       - structural_issues: string option (none, or description)
       - confidence: high | medium | low

       Output: Writes (semantic-review ...) block to .borg.meta file
       sibling to the corresponding .borg file. See meta.borg for
       block format specification.

       Commands exposed:
       - borge review FILE — review single file
       - borge review --dir DIR — review all .ml in directory
       - borge review --all — review entire project
       - borge review --stale — only review files with stale metadata
     |))
   )
  )
  (subsection review-prompt
   (doc "Prompt assembly for semantic review LLM queries")
   (status planned)
   (details
    (doc (|
       review_prompt.ml: builds prompts for semantic review.

       Functions:
       - build_review_prompt: spec_section -> module_surface -> string
       - format_function_for_review: function_info -> string

       The prompt includes:
       1. The spec section describing this module (doc body)
       2. List of functions with signatures and docstrings
       3. Structured output constraint (sexp format only)

       Token management: If prompt would exceed ~8k tokens, truncate
       function signatures (keep names only) and move full signatures
       to a follow-up batch.
     |))
   )
  )
  (subsection review-parse
   (doc "Parse LLM responses into typed semantic findings")
   (status planned)
   (details
    (doc (|
       review_parse.ml: parses sexp responses from LLM.

       Handles:
       - Well-formed (findings ...) blocks → semantic_finding list
       - Malformed responses → Parse_error logged, empty list returned
       - Partially valid → extracts valid findings, logs invalid remainder

       Never raises on parse failure — always returns result type.
     |))
   )
  )
 )
)
