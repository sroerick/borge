 (doc "Domain operations: checking, reporting, formatting, spec extraction.\n       Organized into concern-based subdirectories under lib/ with\n       include_subdirs unqualified — same flat namespace, better layout.")
 (status implemented)
 (exports project_name
  find_roots
  find_orphans
  run_lint
  check_code_quality
  run_check
  run_report
  run_drift
  run_fmt
  extract_surface
  parse_dune
  count_sections
  status_counts
  tree_status_counts
  new_bug
  list_bugs
  load_bug
  save_bug
  close_bug
  json_drift
  json_report
  json_spec
  bug_ast
  bug_parse
  bug_write
  bug_registry
  review_types
  review_prompt
  review_parse
  review_agent
  extract_parsetree
  extract_functions
  extract_docs
  borg_comment
  module_spec
  semantic_review
  convention
  go_parse
  go_surface
  go_doc_extract
 )
 (section config
  (doc "Configuration loading from .borgerc files. lib/config/")
  (status planned)
  (subsection config-core
   (doc "Read, merge, and expose borge configuration")
   (status planned)
   (details
    (doc (|
         config.ml reads .borgerc files and exposes a typed
         config record to all borge commands.

         Types:
         - api_key_source: Env of string | Literal of string
         - config: {
             developer_name : string option;
             api_keys : (string * api_key_source) list;
           }

         Functions:
         - load_config : unit -> config
             Read project .borgerc, merge with
             ~/.config/borge/config, return merged config.
             Project values override user values.
         - load_project_config : unit -> config option
             Read ./.borgerc only. None if file missing.
         - load_user_config : unit -> config option
             Read ~/.config/borge/config only.
             None if file missing.
         - resolve_api_key : config -> string -> string option
             Look up a provider key by name. Resolve (env X)
             by reading the env var. Return None if not found.
         - developer_name : config -> string
             Return the configured developer name, or "agent"
             if not set.

         The developer_name function is used by lock-prompt,
         lint, and comment-generating code to set the authorship
         on annotated comments. Today these default to "agent";
         with config, they use the developer's chosen name.

         resolve_api_key is used by agent.ml and review_agent.ml
         when calling LLMs directly (not via pi). Today they
         only support BORGE_AGENT_CMD env var; config adds
         per-provider key resolution with env var indirection.
       |))
   )
  )
 )
 (section convention
  (doc "Convention dispatch: select the right module set based on project convention")
  (status implemented)
  (subsection convention-core
   (doc "Convention type, resolution from .borg files, fallback to ocaml-dune")
   (status implemented)
   (details
    (doc (|
         Convention.ml provides convention-aware dispatch for borge commands.
         Reads the (convention NAME) form from the root .borg file and
         returns a typed Convention.t variant.

         Types:
         - Convention.t: Ocaml_dune | Go_standard

         Functions:
         - Convention.name : t -> string
         - Convention.source_extension : t -> string
         - Convention.interface_extension : t -> string option
         - Convention.excluded_dirs : t -> string list
         - Convention.of_string : string -> t option
         - Convention.resolve_from_file : string -> t
         - Convention.resolve : string -> t
       |))
   )
  )
 )
)
