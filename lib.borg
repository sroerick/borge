 (section spec-in-code
  (doc "Spec sections embedded in source files. lib/spec_in_code/")
  (status planned)
  (subsection spec-in-mli
   (doc "Extract borge spec sections from OCaml .mli comments")
   (status planned)
   (verify (build) (test "test/spec_in_code.ml"))
   (details
    (doc (|
         An .mli file may carry a borge spec section as a top-of-file
         comment. The comment uses the standard (* ... *) OCaml delimiter
         and contains a complete (section ...) or (subsection ...) form:

         (* borge (subsection login
            (doc "Login form and handlers")
            (status implemented)
            (endpoint GET (verify (build) (smoke "GET /login")))
            (endpoint POST (verify (build) (test "test/auth_login.ml")))
         ) *)

         The .mli is the declaration layer for OCaml modules. Putting the
         spec there means one file answers both "what must exist?" (types,
         signatures) and "why? is it done? how to verify?" (borg spec).

         Types:
         - mli_spec: { name : string; kind : [Section | Subsection];
                       status : Spec.status option;
                       verify : Spec.verify_item list;
                       children : mli_spec list;
                       raw : string; line : int }

         Functions:
         - extract_from_mli : string -> mli_spec list
             Scan an .mli file for (* borge (section ...) *) and
             (* borge (subsection ...) *) comments. Returns all
             top-level spec sections found. Parses the borge sexp
             inside the comment using the existing Borge_lang.Parse.
         - spec_to_section_mapping : mli_spec -> Spec.section_mapping
             Convert to the existing section_mapping type so that
             drift, check, and report work unchanged.
         - is_spec_comment : string -> bool
             Returns true if a comment line starts a borge spec block.

         Integration with build_tree:
         project.ml:build_tree is extended so that (inline target.mli)
         resolves targets ending in .mli by calling extract_from_mli
         instead of parse_file. The extracted mli_spec becomes a child
         node in the project tree. The project tree representation is
         unchanged — only the source format differs.

         Index relationship:
         The root .borg file uses (inline auth/login.mli) to declare
         that login.mli carries the spec for the login subsection.
         The .mli file is the authority for the spec detail. The
         association to the implementation is implicit by convention:
         login.mli describes the module implemented in login.ml.
         No (implements ...) declaration is needed — surface extraction
         already pairs .mli with .ml.

         Drift detection:
         Works identically. Borge reads the spec from login.mli's
         comment, reads the code surface from login.ml, and checks
         coherence. Drift does not need to change — the spec model
         (section_mapping) is the same regardless of whether the
         spec source was a .borg file or a .mli comment.
       |))
   )
  )
  (subsection comment-parser
   (doc "Extend borg_comment.ml to handle section/subsection forms")
   (status planned)
   (details
    (doc (|
         Currently borg_comment.ml extracts leaf forms: (fn ...),
         (val ...), (type ...). For spec-in-mli, it must also extract
         nested forms: (section ...), (subsection ...) with arbitrary
         children including (verify ...), (endpoint ...), etc.

         The existing is_borg_form checks the top-level atom. Extend
         to also match "section" and "subsection". The parse_comment
         function already calls Borge_lang.Parse.parse — the parser
         handles arbitrary nesting. The only change is what form types
         trigger extraction, and preserving the entire nested subtree
         rather than flattening to a (form_type, name) pair.

         Functions:
         - is_section_form : string -> bool
             Recognizes (section ...) and (subsection ...) comment
             content, same pattern as existing is_borg_form.
         - extract_section : Borge_lang.Ast.file -> mli_spec list
             Walk parsed top-level forms, extract section/subsection
             nodes into the mli_spec tree type.
       |))
   )
  )
  (subsection inline-resolution
   (doc "Extend build_tree to resolve (inline file.mli) targets")
   (status planned)
   (details
    (doc (|
         project.ml:build_tree currently only handles .borg targets
         (calls parse_file). The extension:

         1. Check file extension of inline target.
         2. If target ends in .borg: existing path (parse_file).
         3. If target ends in .mli: call extract_from_mli, convert
            each mli_spec to a project_node.
         4. If target ends in anything else: error (unsupported).

         The project_node type does not change. The source field is
         already a path string. The children come from the mli_spec
         tree (nested subsections become nested project_nodes).

         Cycle detection: works identically — the visited list tracks
         paths regardless of extension.

         find_root_candidates: must also consider .mli files that
         contain (no-inline) declarations in their spec comments.
         An .mli file whose spec comment does not declare (no-inline)
         and is not inlined by any parent is orphaned.
       |))
   )
  )
 )
 (section book
  (doc "Codebase book printer. lib/book/")
  (status planned)
  (subsection book-print-impl
   (doc "Linearize source files to a paginated PDF (four-tier order: root .borg, other top-level .borg, .mli, .ml)")
   (status implemented)
   (* agent note (|
     verified at this commit: build-pass, smoke-pass (borge book print
     . opens with borge.borg as the introduction, then the other 8
     top-level .borg design docs, then .ml implementations; line
     numbers on every page; tree_checksum deterministic across runs).
     Uses lstinputlisting with sanitized temp files to dodge the UTF-8
     and \end{lstlisting}-in-source problems.
   |) *)
   (verify (build) (smoke "borge book print"))
   (details
    (doc (|
         lib/book/print.ml — the v1 linearizer and LaTeX emitter.

         v1 scope: four-tier data-driven ordering (root .borg ->
         other top-level .borg -> .mli -> .ml), no full spec-order,
         no --section, no --woven. The root .borg (via
         Project.find_roots) opens the book as the introduction;
         other top-level .borg files follow as design docs; then
         .mli interfaces; then .ml implementations. Each file is
         read, sanitized, emitted as one LaTeX document, run through
         pdflatex.

         Pipeline:
         1. collect_files : dir -> string list
              Roots via Project.find_roots, normalized to paths
              relative to dir. Then a deterministic walk of all
              .borg (excl. .borg.meta), .mli, .ml files. Dedup
              roots from the walk. Sort by:
                (a) tier_of: tier 0 = root .borg, tier 1 = other
                    top-level .borg, tier 2 = .mli, tier 3 = .ml.
                (b) within the code tier (2/3): a dependency rank
                    computed from `open X` and `Module.ref` per
                    file — module basenames map to directories; a
                    longest-path rank per dir (lang=0, core=1, ...).
                    Stdlib/external names are excluded so a project
                    module that shadows a stdlib name (lib/format)
                    doesn't create a false dep.
                (c) then dir_group (lib/ then bin/ then test/).
                (d) then lexical.
              Foundations precede dependents. Skip _build/, .git/,
              and .gitignore build artifacts.
         2. file_to_latex : path -> lines -> string
              Emit \section{path} + \begin{lstlisting} block:
              numbers=left, frame=single, basicstyle mono, break
              lines, wide right margin for marginnote annotations.
         3. render : dir -> stem -> unit
              Assemble preamble + body + \end{document}, shell out
              to pdflatex (loop passes until .aux/.toc stabilize),
              write the manifest sidecar via book-manifest-impl.

         Backend selection at runtime: pdflatex on PATH -> LaTeX;
         else groff on PATH -> groff/ms; else error. Not config.

         Shell-out uses Unix.open_process and checks the exit code;
         a failed pdflatex is a hard error, not a silent fallback.
       |))
   )
  )
  (subsection book-manifest-impl
   (doc "Manifest sidecar: page N -> file, plus a tree checksum")
   (status implemented)
   (* agent note (|
     verified at this commit: build-pass. start_page per file parsed
     from the .aux (\newlabel{file:...}), exact — no estimation.
     Line numbers are NOT stored (printed on the page by listings).
   |) *)
   (details
    (doc (|
         lib/book/manifest.ml — the round-trip anchor. JSON (yojson).

         Fields per book-manifest in borge.borg: stem, rendered_at,
         backend, tree_checksum, pages. tree_checksum is a sha1 over
         the ordered (path, content-sha1) list — ordered so a file
         reorder is detectable, not just content changes.

         Line numbers are printed on the page by listings
         (numbers=left) and read off the page by absorb — the
         manifest never stores line ranges. pages entries carry
         only n (page number) and file (source path on that page),
         so a note in the gutter between two files is unambiguous.
         This avoids parsing PDF page breaks entirely: the line
         precision comes free from the rendered page, not from a
         sidecar.

         Functions:
         - build : dir:string -> files:string list -> manifest
         - to_json : manifest -> string
         - tree_checksum : files:string list -> string
       |))
   )
  )
  (subsection book-absorb-impl
   (doc "Scan -> inbox items. NOT implemented in v1.")
   (status planned)
   (details
    (doc (|
         lib/book/absorb.ml — stub in v1. The full pipeline (vision
         LLM per page, manifest lookup, inbox emission) is spec'd
         in borge.borg book-absorb but is out of scope for the first
         print pass. This subsection exists so the module has a home
         when it lands.
       |))
   )
  )
 )
