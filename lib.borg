 (section review
  (doc "Semantic code review with LLM")
  (status implemented)
  (subsection semantic-review
   (doc "Verify function docs match implementation")
   (status implemented)
   (details
    (doc (|
       semantic_review.ml implements per-function LLM verification.

       Extraction: Uses compiler-libs/ocaml-common to parse .ml/.mli
       files into Parsetree. Extracts:
       - Value bindings (Pstr_value)
       - Docstrings (attribute "ocaml.doc")
       - Type signatures (from .mli when available)

       Batching: Files with >20 functions are batched into groups
       of 15-20, alphabetically sorted for determinism.

       LLM Prompt: See meta.borg (section semantic-review-integration)
       for the exact prompt template. Returns structured sexp that
       parses into semantic_finding record.

       Error handling: Parse failures are logged to stderr with raw
       response preserved for debugging. Previous .borg.meta content
       is preserved — never corrupt metadata.

       Data types:
       - doc_present: bool — is there a docstring/comment?
       - doc_accuracy: high | medium | low — does doc match code?
       - signature_match: accurate | mismatch | unknown
       - behavior_coverage: complete | partial | missing
       - structural_issues: string option (none, or description)
       - confidence: high | medium | low

       Output: Writes (semantic-review ...) block to .borg.meta file
       sibling to the corresponding .borg file. See meta.borg for
       block format specification.

       Commands exposed:
       - borge review FILE — review single file
       - borge review --dir DIR — review all .ml in directory
       - borge review --all — review entire project
       - borge review --stale — only review files with stale metadata
     |))
   )
  )
  (subsection review-prompt
   (doc "Prompt assembly for semantic review LLM queries")
   (status implemented)
   (details
    (doc (|
       review_prompt.ml: builds prompts for semantic review.

       Functions:
       - build_review_prompt: spec_section -> module_surface -> string
       - format_function_for_review: function_info -> string

       The prompt includes:
       1. The spec section describing this module (doc body)
       2. List of functions with signatures and docstrings
       3. Structured output constraint (sexp format only)

       Token management: If prompt would exceed ~8k tokens, truncate
       function signatures (keep names only) and move full signatures
       to a follow-up batch.
     |))
   )
  )
  (subsection review-parse
   (doc "Parse LLM responses into typed semantic findings")
   (status implemented)
   (details
    (doc (|
       review_parse.ml: parses sexp responses from LLM.

       Handles:
       - Well-formed (findings ...) blocks → semantic_finding list
       - Malformed responses → Parse_error logged, empty list returned
       - Partially valid → extracts valid findings, logs invalid remainder

       Never raises on parse failure — always returns result type.
     |))
   )
  )
  (subsection review-types
   (doc "Types for semantic review findings")
   (status implemented)
   (details (doc (|Review_types defines semantic_finding and related data types.|)))
  )
  (subsection review-agent
   (doc "LLM agent for semantic code review")
   (status implemented)
   (details (doc (|Review_agent orchestrates LLM calls for semantic review.|)))
  )
  (subsection extract-parsetree
   (doc "OCaml parsetree extraction for semantic review")
   (status implemented)
   (details (doc (|Extract_parsetree uses compiler-libs to parse .ml files into parsetree.|)))
  )
  (subsection extract-functions
   (doc "Function extraction from parsetree")
   (status implemented)
   (details (doc (|Extract_functions extracts function bindings from OCaml parsetree.|)))
  )
  (subsection extract-docs
   (doc "Docstring extraction from parsetree")
   (status implemented)
   (details (doc (|Extract_docs extracts docstrings from parsed OCaml source.|)))
  )
 )
 (section doc
  (doc "Documentation coverage detection and enforcement for .ml files")
  (status in-progress)
  (subsection doc-extract
   (doc "Extract top-level let bindings from OCaml source files")
   (status implemented)
   (details
    (doc (|
         Gathers all top-level value bindings from .ml files,
         distinguishing between public exports and internal helpers.
         Filters out test bindings, ignored bindings, and local opens.

         Types:
         - binding_info: { name; line; is_exported; is_test; is_internal }

         Functions:
         - extract_bindings : string -> binding_info list
             Parse a .ml file and return all top-level let bindings
             with name, line number, and classification.
         - extract_binding_name : string -> string option
             Parse a let-binding line to extract the binding name.
         - find_ml_files : string -> string list
             Recursively find .ml files under a directory,
             skipping _build/ and .git/.
         - extract_project_bindings : string -> (string * binding_info) list
             All bindings from all .ml files, paired with file path.
         - count_stats : binding_info list -> int * int * int * int
             Returns (total, exported, tests, internal).

         Classification rules:
         - is_test: line starts with let%
         - is_internal: name starts with _ or is a test binding
         - is_exported: not internal and name starts with lowercase a-z

         Skips let open and let module forms.
       |))
   )
  )
  (subsection doc-detect
   (doc "Detect documentation comment formats preceding let bindings")
   (status implemented)
   (details
    (doc (|
         Identifies various documentation formats and exempt markers
         on lines preceding a let binding:
         - Standard docstrings: (** ... *)
         - Borg annotated: (* author note (|...|) *)
         - Short borg: (*| ... |*)
         - Exempt: (* exempt doc *)

         Types:
         - doc_kind: Docstring of string | Borg_note of string*string
                     | Borg_short of string | Exempt_marker
         - doc_position: Preceding of int | Inline | None_found
         - binding_doc: { binding_line : int; doc : (doc_kind * doc_position) option }

         Functions:
         - parse_doc_line : string -> doc_kind option
             Classify a single line as one of the four doc kinds
             or return None.
         - extract_file_docs : string -> binding_doc list
             Scan a .ml file for all let bindings and their
             preceding doc comments. Returns one binding_doc per
             binding with the closest preceding comment.
         - binding_has_doc : binding_doc -> bool
             True if doc exists and is not Exempt_marker.
         - binding_is_exempt : binding_doc -> bool
             True if doc is Exempt_marker.

         Detection logic for extract_file_docs:
         - Walk lines left to right, accumulating a prev_docs stack.
         - When a let-binding line is found, search prev_docs
           backward for the nearest parse_doc_line hit.
         - Stop searching at the first non-comment, non-empty line.
         - This handles multi-line comments and blank lines between
           comment and binding.
       |))
   )
  )
  (subsection doc-coverage
   (doc "Compute documentation coverage statistics and write .borg.meta blocks")
   (status implemented)
   (details
    (doc (|
         Computes per-file and project-wide doc coverage, formats
         human-readable reports, and generates (documentation ...)
         blocks for .borg.meta files.

         Types:
         - file_coverage: { path; total_bindings; documented; exempt;
                            undocumented; coverage_percent;
                            undocumented_names }
         - project_coverage: { files; total_files; total_bindings;
                                total_documented; total_exempt;
                                total_undocumented; overall_percent }

         Functions:
         - calculate_file_coverage : string -> file_coverage
             Combine Doc_extract.extract_bindings with
             Doc_detect.extract_file_docs. Skip tests and internals.
             coverage_percent = documented / (total - exempt) * 100.
         - calculate_dir_coverage : string -> project_coverage
             All .ml files under a directory.
         - format_coverage : file_coverage -> string
             "path: N/M documented (X.X%), E exempt, U undocumented"
         - format_project_summary : project_coverage -> string
             Multi-line project summary.
         - generate_meta_block : file_coverage -> string
             Sexp block for .borg.meta:
             (documentation (analyzed-at ...) (file ...) ...)
         - write_coverage_meta : file_coverage -> string -> unit
             Write meta block to a .borg.meta path.
         - meets_threshold : file_coverage -> float -> bool
             Check if coverage_percent >= threshold.

         Coverage calculation:
         documented = bindings with valid doc (not exempt)
         exempt = bindings with (* exempt doc *)
         total_bindings = all extracted bindings (after filtering tests/internals)
         undocumented = total - documented - exempt
         coverage_percent = documented / (total - exempt) * 100

         Integration: called by borge drift --docs (see borge.borg
         code-documentation.doc-coverage-command).
       |))
   )
  )
 )
 (section config
  (doc "Configuration loading from .borgerc files. lib/config/")
  (status planned)
  (subsection config-core
   (doc "Read, merge, and expose borge configuration")
   (status planned)
   (details
    (doc (|
         config.ml reads .borgerc files and exposes a typed
         config record to all borge commands.

         Types:
         - api_key_source: Env of string | Literal of string
         - config: {
             developer_name : string option;
             api_keys : (string * api_key_source) list;
           }

         Functions:
         - load_config : unit -> config
             Read project .borgerc, merge with
             ~/.config/borge/config, return merged config.
             Project values override user values.
         - load_project_config : unit -> config option
             Read ./.borgerc only. None if file missing.
         - load_user_config : unit -> config option
             Read ~/.config/borge/config only.
             None if file missing.
         - resolve_api_key : config -> string -> string option
             Look up a provider key by name. Resolve (env X)
             by reading the env var. Return None if not found.
         - developer_name : config -> string
             Return the configured developer name, or "agent"
             if not set.

         The developer_name function is used by lock-prompt,
         lint, and comment-generating code to set the authorship
         on annotated comments. Today these default to "agent";
         with config, they use the developer's chosen name.

         resolve_api_key is used by agent.ml and review_agent.ml
         when calling LLMs directly (not via pi). Today they
         only support BORGE_AGENT_CMD env var; config adds
         per-provider key resolution with env var indirection.
       |))
   )
  )
 )
