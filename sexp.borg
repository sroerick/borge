(project borge-lang
 (doc "The borge language: parsing, printing, and balancing")
 (status in-progress)
 (exports parse_string parse_file print balance
          string_of_sexp sexp_of_string)
 (section ast
  (doc "AST types for sexp, annotated comments, verbatim strings")
  (status implemented)
  (details
   (doc (|
        Core types:
          sexp = Atom of pos * symbol
               | String of pos * string_value
               | List of pos * sexp list

          string_value = Quoted of quoted_string
                       | Verbatim of verbatim_string

        Comments: plain (;) and annotated (* *).
        Annotated comments carry authorship (Single or Multiple)
        and type (Untyped or Typed of symbol).
        Verbatim strings track nesting depth via v_content.
        Characters | and ) written separately: the closing delimiter
        is NOT included in v_content; it is a delimiter re-added
        by print during output.

        Positions: every sexp node carries a pos record with
        { line: int; col: int; offset: int }. The file type
        holds top_level_comments, top_level sexp_with_comments,
        trailing_comments, and nested_comments for round-tripping.
        nested_comments is a position-pinned list of comments that
        appear inside list forms (before any child sexp). See the
        comment-attachment section for why this is stored as side
        data and not as per-child comments_before. The module also
        exposes fold_comments and iter_comments, single traversals
        over all comments in a file (top-level, before each node,
        nested, trailing) used by lint and the book renderer so
        the walk is defined once.
      |))
  )
 )
 (section parser
  (doc "Hand-written recursive descent parser — to be replaced by sedlex+menhir")
  (status implemented)
  (details
   (doc (|
        Current: parse.ml is a 311-line hand-written character-by-character
        parser. It uses a mutable state record { input; pos; line; column }
        and parses sexp forms by peek/advance. The Lexer module is limited
        to is_symbol_char/is_whitespace helpers — parse.ml does its own
        tokenization inline.

        What it handles:
        - Atom: bare symbols (a-z, A-Z, 0-9, -, _, ., ?, !)
        - Quoted strings: "..." with \n, \t, \\, \" escapes
        - Verbatim strings: open-pipe then close-pipe with nesting
          depth tracking
        - Plain comments: ; to end of line
        - Annotated comments: hash-open then star-close, with
          author [type] value format
          authorship (single or multiple), comment_type, and value
          (Quoted or Verbatim)
        - Lists: ( ... ) with comments_before attachments

        What it does NOT handle:
        - Nested OCaml comments: (* (* inner *) outer *) — the
          first *) closes the comment. This is the same limitation
          that makes doc_coverage unreliable in stats.ml.
        - Unicode: ASCII-only symbol characters
        - Good error messages: "unexpected character" with no
          grammar context. Menhir would say "expected RPAREN but
          got SYMBOL at line X, col Y, in rule list_tail".
        - Grammar-as-spec: the parser IS the spec, but it's
          imperative code, not a declarative grammar.
      |))
  )
  (subsection sedlex-lexer
   (doc "Replace char helpers with a proper Unicode-aware tokenizer")
   (status implemented)
   (details
    (doc (|
          sedlex produces a lexer from .lex (or inline) rules.
          Tokens are already defined in lexer.ml:
            LPAREN, RPAREN, HASH_LPAREN, STAR_RPAREN,
            VERB_OPEN, VERB_CLOSE, QUOTED of string,
            SYMBOL of string, SEMICOLON of string, EOF

          The new lexer will:
          - Actually produce these tokens (currently they're unused)
          - Handle Unicode identifiers via sedlex character classes
          - Handle nested comments by tracking depth in lexer state
          - Attach source positions to every token
          - Replace the inline char scanning in parse.ml

          Key: the nested-comment problem is a LEXER concern, not
          a parser concern. sedlex tracks depth with a ref cell
          and only emits STAR_RPAREN when depth hits 0.
    |))
   )
  )
  (subsection menhir-parser
   (doc "Replace hand-written descent with LR(1) grammar")
   (status implemented)
   (details
    (doc (|
          menhir produces a parser from .mly grammar rules.
          The grammar is small — borge sexp has ~8 production rules:

            file       ::= comment* (sexp comment*)*
            sexp       ::= atom | string | list
            list       ::= LPAREN sexp* RPAREN
            string     ::= QUOTED | verbatim
            verbatim   ::= VERB_OPEN content VERB_CLOSE
            comment    ::= SEMICOLON text
                          | HASH_LPAREN author type value STAR_RPAREN
            author     ::= SYMBOL | LPAREN SYMBOL+ RPAREN
            type       ::= /* empty */ | SYMBOL
            value      ::= /* empty */ | string

          Nested comments: comments appearing inside a list (between
          child sexps) are captured into file.nested_comments as a
          position-pinned (pos * comment_attachment) list, rather
          than discarded. The list spine (LPAREN sexp* RPAREN) is
          unchanged — comments remain side data, not children.
          Comment start_line/end_line are now filled from menhir
          $startpos/$endpos (previously hardcoded to 0). See
          comment-attachment for the future child-attachment plan.

          The .mly becomes the canonical language definition —
          the spec IS the grammar. This is recursive: borge.borg
          describes the .borg format, and the .mly IS the .borg
          format, formally specified.

          Benefits:
          - Grammar-as-spec: the .mly is the authoritative format def
          - Generated error messages with position and expected tokens
          - Incremental parsing possible (menhir --incremental)
          - The grammar is diffable and reviewable, unlike 311 lines
            of imperative state mutation

          Migration plan:
          1. Write parser.mly producing the same Ast types
          2. Write sedlex lexer producing the existing token type
          3. Replace Parse.parse_file with menhir entry point
          4. Verify all tests pass (same AST, same behavior)
          5. Remove hand-written parse.ml
    |))
   )
  )
 )
 (section print
  (doc "Print AST back to .borg. Preserves comments, diffable output")
  (status implemented)
  (details
   (doc (|
        Canonical formatting rules: keyword forms get children on
        their own lines. Atom names stay inline. (doc ...) and
        (status ...) always inline. Verbatim strings preserve
        content verbatim - the closing delimiter is re-added
        during printing, never stored in v_content.

        Comments: plain as ;text, annotated as (* author type value *).
        The file type (with top_level_comments, trailing_comments,
        and nested_comments) enables full round-tripping: parse ->
        print produces diffable output. Nested comments are re-emitted
        in source position order so their lexical placement is
        preserved.
      |))
  )
 )
 (section comment-attachment
  (doc "Preserve and traverse comments inside nested lists")
  (status implemented)
  (details
   (doc (|
        Most .borg files wrap everything in a single (project ...)
        or (section ...) form. Ordinary top-level comments live in
        file.top_level_comments and file.trailing_comments, and
        comments_before on sexp_with_comments handles comments before
        each top-level node. But comments inside those top-level forms
        — before a (section ...) child inside (project ...), for
        example — are comments inside a list. Historically the parser
        discarded them via inner_comment_list. borge now captures
        them in file.nested_comments instead.
      |))
  )
  (subsection position-pinned
   (doc "Nested comments as position-ordered side data")
   (status implemented)
   (details
    (doc (|
          Implemented approach: nested comments are stored as a flat
          list keyed by their source position. They are re-emitted
          during print by interleaving them with the node stream in
          position order. This is sufficient for round-tripping and
          for consumers (lint, book renderer) that only need to see
          every comment once in source order. It does not model
          semantic attachment of a comment to a specific child node;
          that is deferred to future work (child-attachment).
      |))
   )
  )
  (subsection child-attachment
   (doc "Future: make List children carry comments_before directly")
   (status planned)
   (details
    (doc (|
          Long-term design: change Ast.sexp List children from bare
          sexp to sexp_with_comments, so every child in a list has
          its own comments_before. This is the principled data model:
          a comment before (section foo ...) becomes structurally
          attached to that section. The migration is larger (~3-digit
          pattern sites in drift/lint/balance visitors) and will be
          done as a separate refactor.
      |))
   )
  )
 )
 (section balance
  (doc "Fast paren balance check with lexical context tracking")
  (status implemented)
  (details
   (doc (|
        Character-level state machine that counts only structural
        parens, skipping comments, verbatim strings, and quoted
        strings via a state stack. States: Normal, Plain_comment,
        Annotated_comment, Quoted_string, Verbatim(depth),
        Inline_example(depth).

        Reports: Balanced with max nesting depth, or Imbalanced
        with structured error details (Unexpected_close with
        position pairing, Unclosed_parens with paren stack,
        Unclosed_context for un-closed lexical states).

        This is NOT the parser — it's a fast pre-check. It does
        not build an AST. It stays character-level even after
        the menhir rewrite because speed matters for this tool.
        The parser rewrite does not affect balance.ml.

        Verbatim and inline-example nesting: both track depth
        counters. Nested open-pipe close-pipe pairs are valid.
        Nested angle-bracket example delimiters are also valid.
        Balance counts the outer parens correctly.
   |))
  )
  (subsection enhanced-output
   (doc "Structural skeleton, indent divergence, and smart close suggestions")
   (status implemented)
   (details
    (doc (|
         When balance finds errors, it reports them concisely
         with one line per issue. It also validates that
         structural `)` on their own line match the column of
         their matching `(` — catching the common agent mistake
         of closing the wrong form. Errors include:
         - unexpected_close: `)` with no matching `(`
         - unclosed_parens: EOF reached with open forms
         - unclosed_context: unclosed string/verbatim/comment
         - indent_mismatch: structural `)` at wrong column

         With --verbose, balance shows the full paren stack.
    |))
   )
  )
  (subsection indent-repair
   (doc "Infer missing or extra parens from indentation (Parinfer-style)")
   (status implemented)
   (details
    (doc (|
         Agents are good at indentation (visual/spatial) but
         bad at counting parens (symbolic/stateful). When a
         .borg file has balance errors, the single most useful
         recovery action is to treat indentation as the
         canonical structure and infer the parens from it.

         The `--repair` flag produces a corrected version of
         the file by reading indentation as a tree:

         Algorithm (one-pass line scanner):
         1. Track open forms with (line, indent, keyword).
         2. For each new line at indent I, close every form
            whose indent >= I and has not been explicitly closed.
         3. Missing closes become new lines at the correct
            indentation (one `)` per line, innermost first).
         4. Structural `)` that don't match their opener are
            trimmed. Inline `)` that overflow the stack are
            trimmed. At EOF, close all remaining open forms.
         5. Repaired file is guaranteed to pass `borge balance`.

         Lexical context: the repair scanner MUST skip
         comments, verbatim strings, and quoted strings
         using the same state stack as the balance checker.
         It MUST NOT repair inside string literals or
         comments.

         Output modes:
         - `borge balance --repair FILE` prints the corrected
           file to stdout (exit 0 even if repairs were made).
         - `borge balance --repair-diff FILE` shows a diff
           between original and repaired.
         - Combined with `--json`, outputs repair_actions:
           [{"action":"insert_line","line":12,"indent":3,
             "reason":"close beta opened at line 4"}]
           plus "repaired_text" with the full corrected file.

         Canonical format assumption: repair assumes the
         file follows borge canonical formatting (one form
         per line, strictly nested). Non-canonical files
         may still repair correctly but are not guaranteed.
    |))
   )
  )
  (subsection enriched-json
   (doc "Structured tree + repair actions in JSON output")
   (status implemented)
   (details
    (doc (|
         When `--json` is passed, balance produces a rich
         structured response that programmatic consumers
         (agents) can act on without parsing human text:

         ```json
         {
           "status": "imbalanced",
           "errors": [
             {"type":"indent_mismatch","pos":{"line":6,"col":3},
              "expected_col":2,"keyword":"section",
              "open_pos":{"line":2,"col":2}}
           ],
           "structural_tree": [
             {"line":1,"depth":1,"keyword":"project",
              "open_col":1,"closed":false},
             {"line":3,"depth":2,"keyword":"section",
              "open_col":2,"closed":false},
             ...
           ],
           "indent_divergences": [
             {"line":13,"col":3,"depth":5,"expected_col":5,
              "hint":"a `)` may be missing before this line"}
           ],
           "repair_actions": [
             {"action":"insert_line","line":5,"indent":3,
              "reason":"close beta opened at line 4"},
             {"action":"remove","line":6,"column":0,
              "text":")",
              "reason":"structural `)` does not match open-paren indentation"}
           ],
           "repaired_text": "(project test\\n ..."
         }
         ```

         The `structural_tree` is a flat list of paren pairs
         in source order. Unclosed pairs are marked
         `"closed": false` with no `close_line` field.

         The `repair_actions` list is only present when the
         file is imbalanced AND `--json` is used. Each action:
         - action: "insert_line" | "remove"
         - line: 1-indexed position in the original
         - indent: for insert_line, the column of the new `)`
         - text: for remove, the string being removed
         - reason: human-readable explanation

         `repaired_text` contains the full corrected file.
    |))
   )
  )
 )
 (section error
  (doc "Error types for parse and balance failures")
  (status implemented)
  (details
   (doc (|
        parse_error: { message: string; line: int; column: int }
        Raised as Parse_error exception from parse.ml.
        After menhir: menhir produces its own error type.
        The balance module has its own error_detail union:
        Unexpected_close, Unclosed_parens, Unclosed_context,
        Indent_mismatch.
   |))
  )
 )
 (section lexer
  (doc "Token types and helper predicates for sexp scanning")
  (status implemented)
  (details
   (doc (|
        lexer.ml defines token types (LPAREN, RPAREN, HASH_LPAREN,
        STAR_RPAREN, VERB_OPEN, VERB_CLOSE, QUOTED, SYMBOL,
        SEMICOLON, EOF) and position tracking. Currently only
        is_symbol_char and is_whitespace are used by parse.ml.
        After sedlex rewrite, this module becomes the generated
        lexer that actually produces these tokens.
   |))
  )
 )
)
