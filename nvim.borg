; borge nvim plugin spec
; The neovim integration for borge
(project borge-nvim
 (doc "Neovim plugin for borge annotated comments and CLI integration")
 (status planned)
 (section overview
  (doc "Minimal plugin for inserting comments without sexp knowledge")
  (status planned)
 )
 (section dependencies
  (doc "What the neovim plugin requires")
  (status planned)
  (subsection borge-cli
   (doc "Borge CLIs must be on PATH")
   (status planned)
  )
  (subsection neovim-version
   (doc "Neovim 0.9+")
   (status planned)
  )
 )
 (section comment-insertion
  (doc "Hotkeys for inserting typed annotated comments")
  (status planned)
  (subsection insert-note
   (doc "leader-bc drops an empty note comment")
   (status planned)
  )
  (subsection insert-design
   (doc "leader-bd drops a design comment for agent implementation")
   (status planned)
  )
  (subsection insert-ask
   (doc "leader-br drops ask plus empty response slot")
   (status planned)
  )
  (subsection insert-todo
   (doc "leader-bt drops a todo item")
   (status planned)
  )
  (subsection author-config
   (doc "Author from vim.g.borge_author, or $BORGE_AUTHOR, or $USER")
   (status planned)
  )
 )
 (section cli-integration
  (doc "Wiring borge CLIs into neovim")
  (status planned)
  (subsection borge-check
   (doc ":BorgeCheck runs borge check, results in quickfix")
   (status planned)
  )
  (subsection borge-drift
   (doc ":BorgeDrift runs borge drift")
   (status planned)
  )
  (subsection borge-parse
   (doc ":BorgeParse syntax checks on save")
   (status planned)
  )
  (subsection borge-status
   (doc ":BorgeStatus shows summary in floating window")
   (status planned)
  )
 )
 (section ask-response
  (doc "Monitoring ask comments with empty response slots")
  (status planned)
  (subsection detection
   (doc "Highlight unanswered asks via borge check --pending-responses")
   (status planned)
  )
  (subsection triggering
   (doc "Signal to pi extension, not direct agent invocation")
   (status planned)
  )
  (subsection arrival
   (doc "Detect agent responses via BufWritePost")
   (status planned)
  )
 )
 (section plugin-structure
  (doc "Lua file structure for the neovim plugin")
  (status planned)
  (subsection layout
   (doc "lua/borge/init.lua, config.lua, comments.lua, cli.lua, diagnostics.lua")
   (status planned)
  )
  (subsection setup
   (doc "require(borge).setup({ author = ... })")
   (status planned)
  )
 )
)
