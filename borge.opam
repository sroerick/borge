opam-version: "2.0"
description: "A spec-driven code orchestrator"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.17" & >= "3.17"}
  "cmdliner" {>= "1.3"}
  "yojson" {>= "2.2"}
  "ppx_deriving" {>= "6.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
